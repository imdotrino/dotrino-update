{
  "name": "@dotrino/update",
  "version": "0.12.2",
  "description": "Enterarse de que hay versión nueva, traerla verificada e instalarla sola. Para los daemons, servicios y CLIs del ecosistema Dotrino.",
  "type": "module",
  "main": "src/index.js",
  "types": "types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./src/index.js"
    },
    "./fetch": {
      "types": "./types/fetch.d.ts",
      "import": "./src/fetch.js"
    },
    "./notice": {
      "types": "./types/notice.d.ts",
      "import": "./src/notice.js"
    },
    "./deps": {
      "types": "./types/deps.d.ts",
      "import": "./src/deps.js"
    },
    "./checkout": {
      "types": "./types/checkout.d.ts",
      "import": "./src/checkout.js"
    },
    "./npm": {
      "types": "./types/npm.d.ts",
      "import": "./src/npm.js"
    },
    "./integrity": {
      "types": "./types/integrity.d.ts",
      "import": "./src/integrity.js"
    },
    "./sources": {
      "types": "./types/sources.d.ts",
      "import": "./src/sources.js"
    },
    "./mirror": {
      "types": "./types/mirror.d.ts",
      "import": "./src/mirror.js"
    }
  },
  "bin": {
    "dotrino-update": "bin/cli.js"
  },
  "files": [
    "bin",
    "src",
    "docs",
    "types",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "type-check": "tsc --noEmit",
    "types": "node scripts/types.mjs",
    "test": "node --test \"test/*.test.mjs\""
  },
  "keywords": [
    "dotrino",
    "update",
    "provenance",
    "sigstore"
  ],
  "peerDependencies": {
    "sigstore": ">=5.0.0"
  },
  "peerDependenciesMeta": {
    "sigstore": {
      "optional": true
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/imdotrino/dotrino-update.git"
  },
  "devDependencies": {
    "@types/node": "22.19.1",
    "typescript": "5.9.3"
  }
}
